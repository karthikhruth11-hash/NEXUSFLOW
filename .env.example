# Environment Mode
NODE_ENV=development
PORT=4000

# MongoDB Configuration
# For local dev without installed Mongo, leave blank or set to memory:// to use in-memory mongo
MONGODB_URI=mongodb://localhost:27017/nexusflow
MONGODB_DB_NAME=nexusflow

# Telemetry & Time Semantics
MAX_LATENESS_SECONDS=60
MAX_BATCH_SIZE=500
BACKPRESSURE_BUFFER_SIZE=10000

# JWT & Authentication
JWT_ACCESS_SECRET=your-256-bit-access-secret-placeholder
JWT_REFRESH_SECRET=your-256-bit-refresh-secret-placeholder
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Logging & Observability
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
